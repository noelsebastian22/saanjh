import Masterpieces from '../components/Masterpieces.astro';
import Band from '../components/Band.astro';
import MenuRegions from '../components/MenuRegions.astro';
import Fullbleed from '../components/Fullbleed.astro';
import Dishes from '../components/Dishes.astro';
import Stats from '../components/Stats.astro';
