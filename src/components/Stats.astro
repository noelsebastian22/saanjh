---
import { site } from '../data/site';
const { stats } = site;
---
<section class="stats section-y border-y" style="border-color: var(--line)">
  <div class="shell">
    <p class="eyebrow reveal">{stats.eyebrow}</p>
    <h2 class="display reveal d1 mt-5 text-[clamp(2.2rem,5.5vw,4.4rem)]">{stats.title}</h2>

    <dl class="mt-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {stats.items.map((stat, i) => (
        <div class={`reveal d${(i % 4) + 1}`}>
          <dd
            class="display gold-text text-[clamp(3rem,7vw,5rem)]"
            data-count={String(stat.value)}
            data-dec={String(stat.dec)}
            data-suffix={stat.suffix}
          >0</dd>
          <dt class="mt-3 text-[0.72rem] uppercase tracking-[0.18em] faint">{stat.label}</dt>
        </div>
      ))}
    </dl>
  </div>
</section>
