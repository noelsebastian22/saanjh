---
/**
 * Signature plates. A carousel the guest controls: swipe on touch, drag or
 * trackpad on desktop, arrow buttons, and arrow keys once the row has focus.
 * It never moves on its own, so nobody has to chase a dish they were reading.
 */
import Img from './Img.astro';
import { site } from '../data/site';
const { masterpieces } = site;
const total = masterpieces.items.length;
---
<section class="signatures section-y" aria-labelledby="signatures-title">
  <div class="shell">
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-8">
      <div class="max-w-3xl">
        <p class="eyebrow reveal">{masterpieces.eyebrow}</p>
        <h2 id="signatures-title" class="display reveal d1 mt-5 text-[clamp(2.2rem,5.5vw,4.4rem)]">
          {masterpieces.title}
        </h2>
        <p class="reveal d2 mt-6 max-w-md text-base leading-relaxed dim">{masterpieces.lede}</p>
      </div>

      <div class="reveal d2 flex items-center gap-3">
        <button type="button" class="carousel-btn" data-carousel-prev aria-controls="signatures-track" aria-label="Previous plates" disabled>
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <button type="button" class="carousel-btn" data-carousel-next aria-controls="signatures-track" aria-label="Next plates">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
      </div>
    </div>
  </div>

  <div class="carousel reveal d3 mt-[clamp(40px,5vw,64px)]" data-carousel>
    <ul
      id="signatures-track"
      class="carousel__track"
      tabindex="0"
      aria-label={`Signature plates, ${total} dishes. Use the arrow keys to move through them.`}
    >
      {masterpieces.items.map((dish, i) => (
        <li class="plate" aria-label={`${i + 1} of ${total}: ${dish.name}`}>
          <div class="plate__frame">
            <Img
              src={dish.img}
              alt={dish.name}
              width={760}
              height={950}
              loading={i < 4 ? 'eager' : 'lazy'}
              draggable="false"
              class="plate__img aspect-[4/5] w-full object-cover"
            />
          </div>
          <div class="plate__caption">
            {dish.origin && <p class="plate__origin">{dish.origin}</p>}
            <h3 class="display plate__name">{dish.name}</h3>
            <p class="plate__note dim">{dish.note}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="shell mt-10">
      <div class="carousel__progress" aria-hidden="true"><span data-carousel-bar></span></div>
    </div>
  </div>
</section>

<style>
  .carousel {
    /* Left edge of the row lines up with the heading above, on any screen width. */
    --edge: max(var(--gutter), calc((100% - var(--maxw)) / 2 + var(--gutter)));
    --gap: clamp(20px, 2.8vw, 44px);
  }

  .carousel__track {
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--edge);
    padding: 6px var(--edge) 10px;
    scrollbar-width: none;
    cursor: grab;
    outline: none;
  }
  .carousel__track::-webkit-scrollbar { display: none; }
  .carousel__track:focus-visible .plate__frame { border-color: rgba(239, 215, 154, 0.55); }
  .carousel__track:global(.is-dragging) {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }

  .plate {
    flex: 0 0 clamp(250px, 24vw, 360px);
    scroll-snap-align: start;
  }
  .plate__frame {
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--color-navy-2);
    transition: border-color 0.5s var(--ease-soft);
  }
  .plate__img {
    transition: transform 1.1s var(--ease-soft);
    -webkit-user-drag: none;
  }
  @media (hover: hover) {
    .plate:hover .plate__img { transform: scale(1.045); }
    .plate:hover .plate__frame { border-color: rgba(201, 162, 75, 0.5); }
  }

  .plate__caption { padding-top: 1.35rem; }
  .plate__origin {
    font-size: 0.68rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-gold);
  }
  .plate__name { margin-top: 0.6rem; font-size: clamp(1.5rem, 2vw, 1.85rem); line-height: 1.05; }
  .plate__note { margin-top: 0.5rem; font-size: 0.9rem; line-height: 1.55; }

  .carousel-btn {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 999px;
    border: 1px solid rgba(201, 162, 75, 0.45);
    color: var(--color-gold);
    transition: background-color 0.3s, color 0.3s, opacity 0.3s, border-color 0.3s;
  }
  .carousel-btn:hover:not(:disabled) { background: var(--color-gold); color: var(--color-navy); }
  .carousel-btn:focus-visible { outline: 2px solid var(--color-gold-hi); outline-offset: 3px; }
  .carousel-btn:disabled { opacity: 0.3; cursor: default; }

  .carousel__progress {
    position: relative;
    height: 1px;
    background: var(--line-soft);
    overflow: hidden;
  }
  .carousel__progress span {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--thumb, 30%);
    background: var(--gold-grad);
    transform: translateX(var(--pos, 0%));
    transition: transform 0.25s linear;
  }
</style>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const section = root.closest('section')!;
    const track = root.querySelector<HTMLElement>('.carousel__track')!;
    const bar = root.querySelector<HTMLElement>('[data-carousel-bar]')!;
    const prev = section.querySelector<HTMLButtonElement>('[data-carousel-prev]')!;
    const next = section.querySelector<HTMLButtonElement>('[data-carousel-next]')!;
    const items = [...track.children] as HTMLElement[];
    const behavior: ScrollBehavior = reduced ? 'auto' : 'smooth';

    const max = () => track.scrollWidth - track.clientWidth;
    const step = () => {
      const a = items[0].getBoundingClientRect();
      const b = items[1]?.getBoundingClientRect();
      return b ? b.left - a.left : a.width;
    };
    /* How many whole plates fit on screen: the buttons page by that many. */
    const perView = () => Math.max(1, Math.floor((track.clientWidth - parseFloat(getComputedStyle(track).paddingLeft)) / step()));

    const sync = () => {
      const m = max();
      const ratio = track.clientWidth / track.scrollWidth;
      const progress = m > 0 ? track.scrollLeft / m : 0;
      bar.style.setProperty('--thumb', `${(ratio * 100).toFixed(2)}%`);
      bar.style.setProperty('--pos', `${((progress * (1 - ratio)) / ratio * 100).toFixed(2)}%`);
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= m - 2;
    };

    let ticking = false;
    track.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { sync(); ticking = false; });
    }, { passive: true });
    addEventListener('resize', sync);
    sync();

    prev.addEventListener('click', () => track.scrollBy({ left: -step() * perView(), behavior }));
    next.addEventListener('click', () => track.scrollBy({ left: step() * perView(), behavior }));

    track.addEventListener('keydown', (e) => {
      const moves: Record<string, number> = { ArrowRight: step(), ArrowLeft: -step() };
      if (e.key in moves) { e.preventDefault(); track.scrollBy({ left: moves[e.key], behavior }); }
      if (e.key === 'Home') { e.preventDefault(); track.scrollTo({ left: 0, behavior }); }
      if (e.key === 'End') { e.preventDefault(); track.scrollTo({ left: max(), behavior }); }
    });

    /* Mouse drag with a little momentum. Touch and trackpads scroll natively. */
    let down = false, moved = false, startX = 0, startLeft = 0, lastX = 0, lastT = 0, velocity = 0;

    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      down = true; moved = false;
      startX = lastX = e.clientX; startLeft = track.scrollLeft;
      lastT = performance.now(); velocity = 0;
    });
    track.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (!moved && Math.abs(dx) > 4) {
        moved = true;
        track.setPointerCapture(e.pointerId);
        track.classList.add('is-dragging');
      }
      if (!moved) return;
      track.scrollLeft = startLeft - dx;
      const now = performance.now();
      /* Smoothed px/ms, capped so one quick flick never empties the row. */
      const v = (e.clientX - lastX) / Math.max(8, now - lastT);
      velocity = Math.max(-2.5, Math.min(2.5, velocity * 0.6 + v * 0.4));
      lastX = e.clientX; lastT = now;
    });
    const release = () => {
      if (!down) return;
      down = false;
      if (!moved) return;
      /* Throw in the direction of travel, then land on the nearest plate. */
      const s = step();
      /* A pause before letting go means no throw. */
      const v = performance.now() - lastT > 90 ? 0 : velocity;
      const reach = s * perView();
      const fling = Math.max(-reach, Math.min(reach, -v * 240));
      const projected = Math.min(max(), Math.max(0, track.scrollLeft + fling));
      const target = Math.round(projected / s) * s;
      track.classList.remove('is-dragging');
      track.scrollTo({ left: target, behavior });
    };
    track.addEventListener('pointerup', release);
    track.addEventListener('pointercancel', release);
    track.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); } }, true);
  });
</script>
