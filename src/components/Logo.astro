---
/**
 * Saanjh mark: the sun going down on the horizon, with its reflection below
 * and the first star of the evening already out. Saanjh means dusk, the hour
 * the fires are lit.
 *
 *   variant="lockup"  mark + wordmark on one line (header)
 *   variant="stacked" mark over wordmark over tagline (footer)
 *   variant="mark"    the mark alone
 *
 * The mark draws in `currentColor` (gold by default), so it recolours with text.
 */
import { site } from '../data/site';

interface Props {
  variant?: 'lockup' | 'stacked' | 'mark';
  size?: number;
  class?: string;
}
const { variant = 'lockup', size = 30, class: className = '' } = Astro.props;
const w = Math.round((size * 56) / 52);
---
{variant === 'mark' ? (
  <svg class={`logo-mark ${className}`} width={w} height={size} viewBox="4 4 56 52" aria-hidden="true" focusable="false">
    <path d="M14 40a18 18 0 0 1 36 0" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
    <path d="M21 40a11 11 0 0 1 22 0" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity=".6" />
    <path d="M27 40a5 5 0 0 1 10 0Z" fill="currentColor" />
    <path d="M6 40h52" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
    <path d="M20 46.5h24M26 52h12" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity=".55" />
    <path d="M51 9.5c.4 3.4 1.3 4.3 4.7 4.7-3.4.4-4.3 1.3-4.7 4.7-.4-3.4-1.3-4.3-4.7-4.7 3.4-.4 4.3-1.3 4.7-4.7Z" fill="currentColor" />
  </svg>
) : (
  <span class={`logo logo--${variant} ${className}`}>
    <svg class="logo-mark" width={w} height={size} viewBox="4 4 56 52" aria-hidden="true" focusable="false">
      <path d="M14 40a18 18 0 0 1 36 0" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
      <path d="M21 40a11 11 0 0 1 22 0" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity=".6" />
      <path d="M27 40a5 5 0 0 1 10 0Z" fill="currentColor" />
      <path d="M6 40h52" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
      <path d="M20 46.5h24M26 52h12" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity=".55" />
      <path d="M51 9.5c.4 3.4 1.3 4.3 4.7 4.7-3.4.4-4.3 1.3-4.7 4.7-.4-3.4-1.3-4.3-4.7-4.7 3.4-.4 4.3-1.3 4.7-4.7Z" fill="currentColor" />
    </svg>
    <span class="logo-word">{site.brand}</span>
    {variant === 'stacked' && <span class="logo-tag">{site.tagline}</span>}
  </span>
)}

<style>
  .logo { display: inline-flex; align-items: center; color: var(--color-cream); }
  .logo-mark { flex: none; color: var(--color-gold); overflow: visible; }
  .logo-word {
    font-family: var(--font-display);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.34em;
    /* Tracking adds space after the last letter too; pull it back so the word centres. */
    margin-right: -0.34em;
    line-height: 1;
  }
  .logo--lockup { gap: 0.75em; font-size: 1.3rem; }
  .logo--stacked { flex-direction: column; align-items: flex-start; gap: 0.9rem; font-size: 1.9rem; }
  .logo-tag {
    font-family: var(--font-body);
    font-size: 0.6rem;
    letter-spacing: 0.32em;
    margin-right: -0.32em;
    text-transform: uppercase;
    color: var(--color-gold);
  }
</style>
