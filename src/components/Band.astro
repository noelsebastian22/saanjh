---
import { site } from '../data/site';
const track = [...site.band, ...site.band, ...site.band];
---
<div class="band marquee border-y py-5" style="border-color: var(--line); --marquee-dur: 38s">
  <div class="marquee__track items-center">
    {track.map((word) => (
      <div class="flex shrink-0 items-center">
        <span class="display px-8 text-[clamp(1.2rem,2.4vw,2rem)] whitespace-nowrap dim">{word}</span>
        <span class="dot h-1.5 w-1.5 shrink-0 rounded-full bg-gold"></span>
      </div>
    ))}
  </div>
</div>
