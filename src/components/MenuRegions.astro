---
import Img from './Img.astro';
import { site } from '../data/site';
const { menu } = site;
---
<section id="menu" class="section-y">
  <div class="shell">
    <div class="grid gap-8 md:grid-cols-12 md:items-end">
      <div class="md:col-span-7">
        <p class="eyebrow reveal">{menu.eyebrow}</p>
        <h2 class="display reveal d1 mt-5 text-[clamp(2.2rem,5.5vw,4.4rem)]">{menu.title}</h2>
      </div>
      <p class="reveal d2 md:col-span-5 text-base leading-relaxed dim">{menu.lede}</p>
    </div>

    <div class="mt-16 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
      {menu.regions.map((region, i) => (
        <article class={`region reveal d${(i % 3) + 1} group`}>
          <div class="overflow-hidden rounded-[var(--radius)]">
            <Img
              src={region.img}
              alt={region.name}
              width={800}
              height={600}
              loading="lazy"
              class="region__img aspect-[4/3] w-full object-cover transition-transform duration-[900ms] ease-soft group-hover:scale-105"
            />
          </div>
          <h3 class="display mt-6 text-2xl">{region.name}</h3>
          <p class="mt-2 text-sm leading-relaxed dim">{region.blurb}</p>
        </article>
      ))}
    </div>
  </div>
</section>
