# Set to 1 to skip build-time image optimisation and emit plain <img> tags
# pointing straight at Unsplash. Use on networks that can't reach
# images.unsplash.com, or for a faster dev loop.
# PUBLIC_RAW_IMAGES=1

# Web3Forms access key for table requests (https://web3forms.com).
# Leave unset to run the booking flow in demo mode.
# PUBLIC_WEB3FORMS_KEY=
